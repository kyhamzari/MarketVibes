{
  "name": "Scholarship",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Scholarship name"
    },
    "provider": {
      "type": "string",
      "description": "Organization or institution offering the scholarship"
    },
    "description": {
      "type": "string",
      "description": "Details about the scholarship"
    },
    "requirements": {
      "type": "string",
      "description": "Eligibility requirements"
    },
    "amount": {
      "type": "number",
      "description": "Scholarship amount in USD"
    },
    "amount_type": {
      "type": "string",
      "enum": [
        "full_tuition",
        "partial",
        "monthly_stipend",
        "one_time"
      ],
      "description": "Type of financial award"
    },
    "category": {
      "type": "string",
      "enum": [
        "undergraduate",
        "postgraduate",
        "phd",
        "vocational",
        "research",
        "other"
      ],
      "description": "Academic level"
    },
    "field_of_study": {
      "type": "string",
      "description": "Field or subject area"
    },
    "country": {
      "type": "string",
      "description": "Country where scholarship is available"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "Application deadline"
    },
    "application_url": {
      "type": "string",
      "description": "Link to apply"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open"
    },
    "poster_name": {
      "type": "string"
    },
    "poster_email": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category"
  ]
}